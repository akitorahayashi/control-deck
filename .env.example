# API Configuration
# Backend API host and port for proxy rewrites
API_HOST=127.0.0.1
API_PORT=8001

# Chat backend base URL exposed to the browser
# Defaults to /api/v1 when omitted, which works with Next.js rewrites
NEXT_PUBLIC_BACKEND_URL=/api/v1

# Enable mock data for development (set to 'true' to use mock streaming instead of real API)
NEXT_PUBLIC_USE_MOCK=false
